# Accounts (sign-up, sign-in, the account page and the admin page) run on
# Supabase. Copy this file to .env.local and fill in the values from your
# Supabase project: Project Settings -> API Keys. If you add Supabase from
# Vercel (Storage -> Supabase), Vercel gets them too, and `vercel env pull
# .env.local` copies them here. Without them, the account pages show their
# sample design and nothing is stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: only ever on the server. Never share it or put it in a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Older Supabase projects call the keys NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY; the site reads those names too.

# Alerts on a person's computer ("Alert me on this computer"): the site's push
# keys. Make a pair once with `npx web-push generate-vapid-keys`. The private
# key is secret: put it in Vercel's Environment Variables yourself, never in a
# chat or a NEXT_PUBLIC_ name. Without them, the button does not appear.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
