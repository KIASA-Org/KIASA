{
  "manifest_version": 3,
  "name": "KIASA ChatGPT Bridge",
  "version": "1.2.0",
  "description": "Carries KIASA's tailoring prompt to ChatGPT in your own signed-in browser, and its answer back to KIASA; and reads the description off a KIASA job's page when KIASA cannot.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kiasa.tech/*",
        "https://www.kiasa.tech/*"
      ],
      "js": [
        "kiasa.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
