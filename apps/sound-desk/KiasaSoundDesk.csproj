<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundDesk</RootNamespace>
    <AssemblyName>KiasaSoundDesk</AssemblyName>
    <Product>KIASA Sound Desk</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\kiasa.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\kiasa.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.1.0" ExcludeAssets="native" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
  </ItemGroup>
</Project>
