<Window x:Class="UserDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIASA Live Desk"
        Width="460" Height="820" MinWidth="360" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" AllowsTransparency="True"
        Background="{StaticResource Night}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Sans}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="assets/userdesk.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar: the app's name, and the window's own buttons. -->
      <Grid x:Name="TopBar" Background="Transparent"
            MouseLeftButtonDown="TopBar_Down" MouseMove="TopBar_Move" MouseLeftButtonUp="TopBar_Up">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image Source="assets/leaf-blue.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="KIASA" FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="Live Desk" Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
          <StackPanel x:Name="ConnInfo" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Off}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock x:Name="ConnStatus" Text="Connecting…" FontSize="11.5" Foreground="{StaticResource InkMute}" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Style="{StaticResource Quiet}" Click="Settings_Click" ToolTip="Settings" Width="34" Height="30" Padding="0">
            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                  Fill="{StaticResource InkSoft}" Stretch="Uniform" Width="15" Height="15"/>
          </Button>
          <Button x:Name="PinButton" Style="{StaticResource Quiet}" Click="Pin_Click" ToolTip="Stay on top of other windows" Width="34" Height="30" Padding="0">
            <Path x:Name="PinMark" Data="M5,0 L11,0 L11,1.5 L9.8,1.5 L9.8,6 L12,8.5 L12,10 L8.7,10 L8.7,15 L7.3,15 L7.3,10 L4,10 L4,8.5 L6.2,6 L6.2,1.5 L5,1.5 Z" Fill="{StaticResource Leaf}" Stretch="Uniform" Width="11" Height="14"/>
          </Button>
          <Button Style="{StaticResource Quiet}" Click="Minimise_Click" ToolTip="Minimise" Width="34" Height="30" Padding="0">
            <Rectangle Width="11" Height="1.2" Fill="{StaticResource InkSoft}"/>
          </Button>
          <Button Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Close" Width="34" Height="30" Padding="0">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource InkSoft}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Settings popup. -->
      <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-186" VerticalOffset="2">
        <Border Background="{StaticResource NightControl}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Width="230" Margin="8">
          <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="#000000"/></Border.Effect>
          <StackPanel>
            <Grid>
              <TextBlock Text="Opacity" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Left"/>
              <TextBlock x:Name="OpacityValue" Text="100%" FontSize="12" Foreground="{StaticResource InkMute}" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock Text="See the screen behind this window." FontSize="11.5" Foreground="{StaticResource InkMute}" Margin="0,2,0,8" TextWrapping="Wrap"/>
            <Slider x:Name="OpacitySlider" Style="{StaticResource ThinSlider}" Minimum="0.25" Maximum="1" Value="1"
                    IsMoveToPointEnabled="True" LargeChange="0.05" SmallChange="0.01" ValueChanged="Opacity_Changed"/>
          </StackPanel>
        </Border>
      </Popup>

      <!-- Signing in. -->
      <Grid x:Name="SignInView" Grid.Row="1" Visibility="Collapsed">
        <StackPanel Width="300" VerticalAlignment="Center" Margin="0,0,0,24">
          <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="With your KIASA account." Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="0,4,0,18"/>
          <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,0,0,5"/>
          <TextBox x:Name="EmailBox" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,12,0,5"/>
          <PasswordBox x:Name="PasswordInput" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <Button x:Name="SignInButton" Style="{StaticResource Strong}" Content="Sign in" Margin="0,18,0,0" Click="SignIn_Click"/>
          <TextBlock x:Name="SignInSaid" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Main desk view, shown after sign-in. -->
      <Grid x:Name="DeskView" Grid.Row="1" Margin="16,10,16,16" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Notification display area. -->
        <Border x:Name="PanelBorder" Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="14" Padding="22,18,22,18">
          <Grid ClipToBounds="True">
            <!-- Empty state. -->
            <TextBlock x:Name="EmptyNote" Text="Waiting for a message." FontSize="14"
                       Foreground="{StaticResource InkMute}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- The admin's selection, drawn by hand so it shows even when this window is inactive. -->
            <Canvas x:Name="SelCanvas" IsHitTestVisible="False"/>
            <!-- Incoming message, read-only. The box is transparent so the highlight shows behind it. -->
            <TextBox x:Name="NotifyBox" TextWrapping="Wrap" FontSize="18"
                     Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True"
                     Foreground="{StaticResource Ink}"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <!-- A caret drawn by hand, so it shows even when this window is not the active one. -->
            <Rectangle x:Name="Caret" Width="2" Fill="{StaticResource Ink}" IsHitTestVisible="False"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
          </Grid>
        </Border>

        <!-- Bottom bar: who is signed in, and sign-out. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,10,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="WhoAmI" FontSize="12" Foreground="{StaticResource InkMute}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button Style="{StaticResource Quiet}" Click="SignOut_Click" Margin="8,0,0,0" Padding="6,3">
            <TextBlock Text="Sign out" FontSize="12"/>
          </Button>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
