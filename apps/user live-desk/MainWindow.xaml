<Window x:Class="UserDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIASA Live Desk"
        Width="560" Height="420" MinWidth="400" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Night}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Sans}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="assets/kiasa.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar: the app's name, and the window's own buttons. -->
      <Grid x:Name="TopBar" Background="Transparent"
            MouseLeftButtonDown="TopBar_Down" MouseMove="TopBar_Move" MouseLeftButtonUp="TopBar_Up">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image Source="assets/leaf.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="KIASA" FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="Live Desk" Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
          <Button Style="{StaticResource Quiet}" Click="Minimise_Click" ToolTip="Minimise" Width="34" Height="30" Padding="0">
            <Rectangle Width="11" Height="1.2" Fill="{StaticResource InkSoft}"/>
          </Button>
          <Button Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Close" Width="34" Height="30" Padding="0">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource InkSoft}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Signing in. -->
      <Grid x:Name="SignInView" Grid.Row="1" Visibility="Collapsed">
        <StackPanel Width="300" VerticalAlignment="Center" Margin="0,0,0,24">
          <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="With your KIASA account." Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="0,4,0,18"/>
          <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,0,0,5"/>
          <TextBox x:Name="EmailBox" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,12,0,5"/>
          <PasswordBox x:Name="PasswordInput" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <Button x:Name="SignInButton" Style="{StaticResource Strong}" Content="Sign in" Margin="0,18,0,0" Click="SignIn_Click"/>
          <TextBlock x:Name="SignInSaid" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Main desk view, shown after sign-in. -->
      <Grid x:Name="DeskView" Grid.Row="1" Margin="16,10,16,16" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Notification display area. -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="14" Padding="24">
          <Grid>
            <!-- Connection status, top-left. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Off}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnStatus" Text="Connecting…" FontSize="11.5" Foreground="{StaticResource InkMute}" Margin="6,0,0,0"/>
            </StackPanel>
            <!-- Empty state. -->
            <TextBlock x:Name="EmptyNote" Text="Waiting for a message." FontSize="14"
                       Foreground="{StaticResource InkMute}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <!-- Incoming message text. -->
            <TextBlock x:Name="NotifyText" TextWrapping="Wrap" FontSize="18" LineHeight="28"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Ink}" Visibility="Collapsed"/>
          </Grid>
        </Border>

        <!-- Bottom bar: who is signed in, and sign-out. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,10,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="WhoAmI" FontSize="12" Foreground="{StaticResource InkMute}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button Style="{StaticResource Quiet}" Click="SignOut_Click" Margin="8,0,0,0" Padding="6,3">
            <TextBlock Text="Sign out" FontSize="12"/>
          </Button>
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
