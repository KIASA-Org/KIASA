<Application x:Class="UserDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- The site's palette. -->
    <SolidColorBrush x:Key="Night" Color="#030807"/>
    <SolidColorBrush x:Key="NightRaised" Color="#0A1410"/>
    <SolidColorBrush x:Key="NightControl" Color="#121E19"/>
    <SolidColorBrush x:Key="Panel" Color="#0A120D"/>
    <SolidColorBrush x:Key="CardHover" Color="#16211A"/>
    <SolidColorBrush x:Key="Ink" Color="#ECFFF3"/>
    <SolidColorBrush x:Key="InkSoft" Color="#C5D4CB"/>
    <SolidColorBrush x:Key="InkMute" Color="#8EA196"/>
    <SolidColorBrush x:Key="Line" Color="#24ECFFF3"/>
    <SolidColorBrush x:Key="CardLine" Color="#14ECFFF3"/>
    <SolidColorBrush x:Key="Leaf" Color="#B8EC93"/>
    <SolidColorBrush x:Key="LeafSoft" Color="#26B8EC93"/>
    <SolidColorBrush x:Key="LeafFaint" Color="#38B8EC93"/>
    <SolidColorBrush x:Key="Warn" Color="#F2D36B"/>
    <SolidColorBrush x:Key="Off" Color="#8A948C"/>

    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- A thin scroll bar, as a dark page would have. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Margin="2,1" CornerRadius="2" Background="#38ECFFF3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#66ECFFF3"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A quiet button: words or a small mark, brighter under the mouse. -->
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#14ECFFF3"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The sign-in's one strong button. -->
    <Style x:Key="Strong" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Night}"/>
      <Setter Property="Background" Value="{StaticResource Leaf}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="#CDF7AC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Back" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
      <Border x:Name="Edge" Height="40" Padding="10,0" CornerRadius="10" BorderThickness="1.5" BorderBrush="#4DECFFF3" Background="{StaticResource NightRaised}">
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Focusable="False"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Leaf}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A thin dark-theme slider with a leaf thumb. -->
    <Style x:Key="ThinSlider" TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" CornerRadius="2" Background="#2EECFFF3" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="15" Height="15" Fill="{StaticResource Leaf}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
