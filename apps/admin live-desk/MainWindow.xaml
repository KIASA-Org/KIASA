<Window x:Class="LiveDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIASA Live Desk"
        Width="780" Height="540" MinWidth="520" MinHeight="340"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowActivated="True"
        Background="{StaticResource Night}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Sans}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="assets/kiasa.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- The top bar: the app's name, and the window's own buttons. Dragged by hand, because a window
           that never takes the keyboard does not move smoothly the usual way. -->
      <Grid x:Name="TopBar" Background="Transparent"
            MouseLeftButtonDown="TopBar_Down" MouseMove="TopBar_Move" MouseLeftButtonUp="TopBar_Up">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image Source="assets/leaf.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="KIASA" FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="Live Desk" Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
          <Button x:Name="PinButton" Style="{StaticResource Quiet}" Click="Pin_Click" ToolTip="Stay on top of other windows" Width="34" Height="30" Padding="0">
            <Path x:Name="PinMark" Data="M5,0 L11,0 L11,1.5 L9.8,1.5 L9.8,6 L12,8.5 L12,10 L8.7,10 L8.7,15 L7.3,15 L7.3,10 L4,10 L4,8.5 L6.2,6 L6.2,1.5 L5,1.5 Z" Fill="{StaticResource Leaf}" Stretch="Uniform" Width="11" Height="14"/>
          </Button>
          <Button Style="{StaticResource Quiet}" Click="Minimise_Click" ToolTip="Minimise" Width="34" Height="30" Padding="0">
            <Rectangle Width="11" Height="1.2" Fill="{StaticResource InkSoft}"/>
          </Button>
          <Button Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Close" Width="34" Height="30" Padding="0">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource InkSoft}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Signing in. -->
      <Grid x:Name="SignInView" Grid.Row="1" Visibility="Collapsed">
        <StackPanel Width="320" VerticalAlignment="Center" Margin="0,0,0,24">
          <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="With your KIASA admin account." Foreground="{StaticResource InkMute}" FontSize="13.5" Margin="0,4,0,18"/>
          <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,0,0,5"/>
          <TextBox x:Name="EmailBox" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,12,0,5"/>
          <PasswordBox x:Name="PasswordInput" Template="{StaticResource FieldTemplate}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" FontSize="14" KeyDown="Field_KeyDown"/>
          <Button x:Name="SignInButton" Style="{StaticResource Strong}" Content="Sign in" Margin="0,18,0,0" Click="SignIn_Click"/>
          <TextBlock x:Name="SignInSaid" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Reading: who is live, and the chosen person's script, a card per sentence. -->
      <Grid x:Name="DeskView" Grid.Row="1" Margin="12,2,12,12" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0C1712" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="14" Padding="8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LiveCount" Text="Live now" FontWeight="SemiBold" FontSize="13.5" Margin="6,4,0,8"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel>
                <TextBlock x:Name="NoOne" Text="No one has their live script on." TextWrapping="Wrap" Foreground="{StaticResource InkMute}" FontSize="13" Margin="6,0" Visibility="Collapsed"/>
                <ItemsControl x:Name="People" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="Person_Click" Focusable="False" Cursor="Hand" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Row" CornerRadius="10" Padding="8,7" Background="Transparent">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Leaf}" Margin="0,0,8,0" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                  <Ellipse.RenderTransform><TranslateTransform Y="6"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                                  <TextBlock Text="{Binding Since}" FontSize="11.5" Foreground="{StaticResource InkMute}"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0FECFFF3"/></Trigger>
                              <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="Row" Property="Background" Value="#24B8EC93"/></DataTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Members" FontWeight="SemiBold" FontSize="13.5" Margin="6,8,0,6"/>
            <Border Grid.Row="3" Background="{StaticResource NightRaised}" BorderBrush="#33ECFFF3" BorderThickness="1" CornerRadius="8" Height="30" Padding="9,0" Margin="2,0,2,6">
              <Grid>
                <TextBlock x:Name="SearchHint" Text="Search members" Foreground="{StaticResource InkMute}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="MemberSearch" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Leaf}" VerticalContentAlignment="Center" FontSize="12.5" PreviewMouseLeftButtonDown="Field_Down" TextChanged="MemberSearch_Changed"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="Members" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Click="Member_Click" Focusable="False" Cursor="Hand" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Row" CornerRadius="10" Padding="8,7" Background="Transparent">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#2EECFFF3" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0FECFFF3"/></Trigger>
                            <DataTrigger Binding="{Binding Online}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource Leaf}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="Row" Property="Background" Value="#24B8EC93"/></DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="5" Margin="0,6,0,0">
              <TextBlock x:Name="WhoAmI" FontSize="12" Foreground="{StaticResource InkMute}" Margin="6,0,0,2" TextTrimming="CharacterEllipsis"/>
              <Button Style="{StaticResource Quiet}" Click="SignOut_Click" HorizontalAlignment="Left" Padding="6,3">
                <TextBlock Text="Sign out" FontSize="12"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="2,3,0,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource Off}"/>
            <TextBlock x:Name="Status" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkSoft}" Text="Choose someone to read their script."/>
            <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource Quiet}" Click="Stop_Click" Visibility="Collapsed" Margin="8,0,0,0" Padding="10,3" Background="{StaticResource NightControl}">
              <TextBlock Text="Stop writing" FontSize="12.5"/>
            </Button>
            <Button x:Name="WordButton" Grid.Column="3" Style="{StaticResource Quiet}" Click="Word_Click" Visibility="Collapsed" Margin="6,0,0,0" Padding="10,3" Background="{StaticResource NightControl}"
                    ToolTip="Write each word as it comes, instead of waiting for each sentence to finish">
              <TextBlock x:Name="WordLabel" Text="Word by word" FontSize="12.5" Foreground="{StaticResource InkSoft}"/>
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="NotifyGap" Width="0"/>
              <ColumnDefinition x:Name="NotifyCol" Width="0"/>
            </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="14" Padding="7,8,3,3">
            <Grid>
              <TextBlock x:Name="CardsEmpty" Margin="8" FontSize="13.5" Foreground="{StaticResource InkMute}" TextWrapping="Wrap" Text="Their words appear here, a card at a time, as they are spoken."/>
              <ItemsControl x:Name="Cards" Focusable="False"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                            ScrollViewer.CanContentScroll="True"
                            PreviewMouseLeftButtonDown="Cards_Down" PreviewMouseMove="Cards_Move" PreviewMouseLeftButtonUp="Cards_Up">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="Scroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,5,0">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Card" Padding="11,6,11,7" Margin="0,0,0,5" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="{StaticResource NightRaised}" Cursor="Hand" SnapsToDevicePixels="True">
                      <TextBlock x:Name="Words" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="{StaticResource InkSoft}" Text="{Binding Text}"/>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Ink}"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding Live}" Value="True">
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LeafFaint}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Picked}" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{StaticResource LeafSoft}"/>
                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Leaf}"/>
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Ink}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- Notify panel: a text input beside the script, shown when a member is selected. -->
          <Border x:Name="NotifyPanel" Grid.Column="2" Visibility="Collapsed"
                  Background="{StaticResource Panel}" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="14" Padding="14,10,10,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="NotifyTo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,0,0,8"/>
              <TextBox x:Name="NotifyBox" Grid.Row="1" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource Ink}" FontSize="14"
                       VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                       AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                       CaretBrush="{StaticResource Leaf}" FontFamily="{StaticResource Sans}"
                       PreviewMouseLeftButtonDown="Field_Down"
                       GotKeyboardFocus="NotifyBox_GotFocus" LostKeyboardFocus="NotifyBox_LostFocus"
                       TextChanged="NotifyBox_Changed" SelectionChanged="NotifyBox_SelChanged"/>
            </Grid>
          </Border>
          </Grid>

          <TextBlock x:Name="Hint" Grid.Row="2" Margin="3,7,0,0" FontSize="11.5" Foreground="{StaticResource InkMute}" TextWrapping="Wrap"
                     Text="Click in a box, then click a card: it goes in where your cursor is. Drag across several, or hold Ctrl to add. Pick the sentence being written and each one goes in as it finishes, or press Word by word to write each word as it comes. Ctrl+Alt+Space writes the bubble's words now."/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
